      "flags": {},
      "order": 5,
      "mode": 0,
      "inputs": [],
      "outputs": [],
      "properties": {
        "text": ""
      },
      "widgets_values": [
        "Important: the branch names are coherent with the original workflow. Suggested filenames:\n- flux-depth-controlnet-v3.safetensors\n- flux-canny-controlnet-v3.safetensors\n- flux-hed-controlnet-v3.safetensors\n- manycore-FLUX.1-Layout-ControlNet.safetensors\n\nFor the manycore Layout branch, download diffusion_pytorch_model.safetensors from manycore-research/FLUX.1-Layout-ControlNet and rename it to manycore-FLUX.1-Layout-ControlNet.safetensors before placing it in the controlnet folder used by your FLUX loader. Do NOT use sd15 controlnet files here."
      ],
      "color": "#234",
      "bgcolor": "#345"
    },
